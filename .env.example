# Copy this file to .env. Never commit .env or downloaded OAuth credentials.

# Google OAuth desktop-app credentials.
GOOGLE_OAUTH_CLIENT_ID=replace-with-desktop-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-desktop-client-secret

# Optional state override. By default metadata and mappings are stored at
# ~/Library/Application Support/calsync/state.sqlite3. OAuth tokens never go here.
# CALSYNC_DATABASE_PATH=/absolute/path/to/state.sqlite3

# Optional daemon log override. Defaults to ~/Library/Logs/calsync/calsync.log.
# CALSYNC_LOG_PATH=/absolute/path/to/calsync.log

# OAuth callback listener. Left unset (the normal case) calsync opens an
# ephemeral loopback port on 127.0.0.1 for the duration of one consent, which
# is what a Desktop OAuth client expects. Set the base URL only on a host
# where consent has to come back through a public address; calsync then holds
# a fixed per-role port and advertises <base>/oauth2callback/<role>, which
# must be a registered redirect URI on the OAuth client.
# CALSYNC_CONNECT_BASE_URL=https://calsync.example.com
# That mode binds 0.0.0.0 by default, so the raw port answers on every
# interface. Put the reverse proxy on the same host and pin it to loopback:
# CALSYNC_CONNECT_BIND_HOST=127.0.0.1
# CALSYNC_CONNECT_PORT_PERSONAL=8801
# CALSYNC_CONNECT_PORT_WORK=8802

# Optional tenant id for multi-tenant hosts (lowercase letters, digits, and
# hyphens, starting with a letter). Each tenant keeps its own accounts,
# mappings, exclusions, watch channels, and OAuth tokens inside the shared
# state database; "default" preserves existing single-user state. One daemon
# serves every authorized tenant on the host — this variable only selects the
# tenant that one-shot commands and unprefixed auth commands act on.
# CALSYNC_TENANT_ID=default

# Shared local vault (connection metadata). Secrets stay in Keychain.
# Default: ~/Library/Application Support/local-vault
# VAULT_HOME=/absolute/path/to/local-vault
# VAULT_SECRETS_BACKEND=keychain

# Primary Google Calendar IDs for each independently authorized account.
# "primary" is usually appropriate after each account is authenticated.
CALSYNC_PERSONAL_CALENDAR_ID=primary
CALSYNC_WORK_CALENDAR_ID=primary

# Google push notifications (optional). Set CALSYNC_WEBHOOK_URL to the public
# HTTPS address a reverse proxy forwards to this daemon, and the sync switches
# from a one-minute poll to a webhook push. Google requires a CA-signed
# certificate matching the hostname; a bare IP address will not work. Leave the
# URL empty to stay on polling (the only option on a laptop behind NAT).
# CALSYNC_WEBHOOK_URL=https://calsync.example.com/gcal/webhook
# The receiver binds loopback; the proxy terminates TLS and forwards to it.
# CALSYNC_WEBHOOK_HOST=127.0.0.1
# CALSYNC_WEBHOOK_PORT=8787
# Local path to match. Defaults to the path of CALSYNC_WEBHOOK_URL; set this
# only when the proxy rewrites the path before forwarding.
# CALSYNC_WEBHOOK_PATH=/gcal/webhook
# Every mirror write also produces a notification, so bursts are coalesced.
# CALSYNC_WEBHOOK_DEBOUNCE_SECONDS=8
# Requested channel lifetime. Google caps this at its own limit and returns the
# real expiry; the daemon re-arms before it lapses.
# CALSYNC_WEBHOOK_CHANNEL_TTL_SECONDS=604800
# CALSYNC_WEBHOOK_RENEW_BEFORE_SECONDS=3600
# Backstop pass while channels are armed. Google states notifications are not
# 100% reliable, so this catches dropped ones and anything missed while down.
# CALSYNC_WEBHOOK_POLL_INTERVAL_SECONDS=900

# Polling and rolling reconciliation window. CALSYNC_POLL_INTERVAL_SECONDS is
# the cadence without push, and the fallback if arming a channel fails.
CALSYNC_POLL_INTERVAL_SECONDS=60
# Force a complete rolling-window reconciliation at least this often. Incremental
# polls between full runs use privacy-minimized Google change feeds.
CALSYNC_FULL_SYNC_INTERVAL_HOURS=24
CALSYNC_WINDOW_PAST_DAYS=30
CALSYNC_WINDOW_FUTURE_DAYS=365

# App-managed daemon log rotation. Logs are written under
# ~/Library/Logs/calsync with private permissions.
CALSYNC_LOG_MAX_BYTES=5242880
CALSYNC_LOG_BACKUPS=5

# Optional IANA fallback used when an event has no usable timezone.
# If omitted, calsync uses the Mac's current system timezone.
CALSYNC_TIMEZONE=America/Los_Angeles

# Onboarding dashboard (calsync web). Loopback and single-tenant by default.
# Set a secret (16+ chars) to require signed tenant links, minted with
# `calsync web link <tenant> [--ttl <days>]` against CALSYNC_WEB_BASE_URL.
# A link is good for 7 days by default; opening it sets a 6-month session
# cookie (marked Secure when the base URL is https). Set the connect
# URL template on gateway/brokered hosts where grants are collected at the
# broker; {slot} (tenant-scoped broker slot, bare role for the default
# tenant), {tenant}, and {role} are substituted.
# CALSYNC_WEB_HOST=127.0.0.1
# CALSYNC_WEB_PORT=8788
# CALSYNC_WEB_SECRET=
# CALSYNC_WEB_BASE_URL=https://calsync.example.com/
# CALSYNC_WEB_CONNECT_URL=https://gateway.example.com/auth/google/connect?slot={slot}
# Behind a proxy that signs people in itself (the gateway's forward_auth),
# name the header it sets with the verified email and the dashboard opens
# that person's tenant with no link: an override from the map below, else a
# stable hash of the address (`calsync web identity <email>` prints it).
# Existing punctuation-slug tenants need an override until migrated. The
# proxy must strip any client-supplied copy of the header. Needs the secret.
# CALSYNC_WEB_IDENTITY_HEADER=x-forwarded-user
# CALSYNC_WEB_IDENTITY_TENANTS=you@example.com=default

# How often the full-window passes may actually run: the dashboard's "Preview
# a sync" and "Check for stray blocks", and the MCP preview_sync / sync_now
# tools. Each reads both calendars end to end and holds the tenant's sync lock
# while it does, so repeating one keeps the real sync waiting behind it. The
# daemon's own passes are never gated.
# Serve the last dry-run result again for this long, at no cost:
# CALSYNC_SCAN_CACHE_SECONDS=30
# Minimum gap between fresh read-only passes:
# CALSYNC_SCAN_MIN_INTERVAL_SECONDS=60
# Minimum gap between passes that write (a prune, sync_now):
# CALSYNC_WRITE_MIN_INTERVAL_SECONDS=300
# Each 0 turns that layer off. The gaps are shared across `calsync web` and
# `calsync mcp`, so a person clicking and an assistant calling draw on one
# allowance.

# Optional exclusions. Prefer the CLI for day-to-day changes:
#   calsync exclude add --from personal --keyword dentist,therapy,school pickup
#   calsync sync --once --dry-run --verbose
#   calsync exclude add KEY1 KEY2
# Environment lists below are merged with CLI-managed entries.
# Copy opaque occurrence/series keys from a detailed dry run, not Google event IDs.
CALSYNC_EXCLUDE_PERSONAL_TO_WORK=
CALSYNC_EXCLUDE_WORK_TO_PERSONAL=

# Optional comma-separated, case-insensitive literal title substrings.
# Entries are trimmed; blanks are ignored. Regex syntax has no special meaning.
# Commas are separators and cannot be escaped inside one keyword. Untitled
# events do not match. Matching stays local and is directional.
CALSYNC_EXCLUDE_PERSONAL_TO_WORK_KEYWORDS=
CALSYNC_EXCLUDE_WORK_TO_PERSONAL_KEYWORDS=
