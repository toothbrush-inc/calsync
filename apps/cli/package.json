{
  "name": "@calsync/cli",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Privacy-preserving bidirectional Google Calendar availability sync",
  "type": "module",
  "bin": {
    "calsync": "dist/cli.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "pretest": "node ../../scripts/require-node.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@calsync/engine": "*",
    "@dvd-toy-box/vault": "^0.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.0.1",
    "googleapis": "^174.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
